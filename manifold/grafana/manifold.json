          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "sum by (tag) (rate(manifold_inbound_traffic_bytes_total{instance=~\"$instance\"}[5m]))",
          "legendFormat": "{{tag}}"
