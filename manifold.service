[Unit]
Description=Manifold panel
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=180
StartLimitBurst=10

[Service]
EnvironmentFile=-/etc/default/manifold
Environment="XRAY_VMESS_AEAD_FORCED=false"
Type=simple
WorkingDirectory=/usr/local/manifold/
ExecStart=/usr/local/manifold/manifold
ExecReload=/bin/kill -USR1 $MAINPID
Restart=on-failure
RestartSec=5s
KillMode=mixed

# The panel stays root: it supervises the proxy processes, edits netfilter
# state and reads TLS private keys. These settings bound what a flaw in the
# panel can reach.
#
# NoNewPrivileges is left off on purpose. Where AppArmor confines wg-quick,
# as Ubuntu 26.04 does, wg-quick moves into narrower profiles to run ip and
# wg, and the kernel refuses any such move once that flag is set: the
# interface fails with "/usr/bin/ip: Operation not permitted". The capability
# bounding set below already caps what a setuid program could gain.
ProtectSystem=full
# ProtectSystem=full makes /usr and /etc read-only; these are the panel's own
# stores. The leading '-' keeps the unit startable before a path exists.
ReadWritePaths=-/etc/manifold -/usr/local/manifold -/var/log/manifold
ReadWritePaths=-/proc/sys/net
# WireGuard inbounds are wg-quick configs, kept where every WireGuard tool looks.
ReadWritePaths=-/etc/wireguard
# The IPsec side of L2TP is one file among strongSwan's own.
ReadWritePaths=-/etc/swanctl
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectClock=yes
ProtectHostname=yes
# read-only, not yes: TLS certificates are commonly kept under /root/cert.
ProtectHome=read-only
LockPersonality=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
RestrictNamespaces=yes
UMask=0077
# AF_PPPOX is how xl2tpd hands an L2TP session to the kernel; without it
# every session is relayed through xl2tpd itself.
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX AF_NETLINK AF_PPPOX
# DAC_OVERRIDE stays so root can read TLS keys owned by another account.
CapabilityBoundingSet=CAP_DAC_OVERRIDE CAP_NET_ADMIN CAP_NET_BIND_SERVICE CAP_NET_RAW
SystemCallArchitectures=native

[Install]
WantedBy=multi-user.target
